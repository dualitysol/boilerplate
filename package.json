{
  "name": "@dualitysol/boilerplate",
  "version": "1.0.0",
  "description": "Enterprise-grade microservices framework for Node.js with GraphQL, TypeScript support, and built-in patterns for scalable architectures",
  "keywords": [
    "microservices",
    "graphql",
    "typescript",
    "framework",
    "boilerplate",
    "guards",
    "decorators",
    "crud",
    "event-driven",
    "service-registry",
    "aws-lambda",
    "kubernetes",
    "grpc",
    "nats",
    "websocket"
  ],
  "homepage": "https://github.com/dualitysol/boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dualitysol/boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/dualitysol/boilerplate/issues"
  },
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./decorators": {
      "types": "./types/decorators.d.ts",
      "import": "./dist/decorators/index.js"
    },
    "./validation": {
      "types": "./types/validation.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./entity": {
      "types": "./types/entity.d.ts",
      "import": "./dist/entity/index.js"
    },
    "./metrics": {
      "types": "./types/metrics.d.ts",
      "import": "./dist/metrics/index.js"
    },
    "./ratelimit": {
      "types": "./types/ratelimit.d.ts",
      "import": "./dist/ratelimit/index.js"
    },
    "./auth": {
      "types": "./types/auth.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./audit": {
      "types": "./types/audit.d.ts",
      "import": "./dist/audit/index.js"
    },
    "./cache": {
      "types": "./types/cache.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./migrations": {
      "types": "./types/migrations.d.ts",
      "import": "./dist/migrations/index.js"
    },
    "./upload": {
      "types": "./types/upload.d.ts",
      "import": "./dist/upload/index.js"
    },
    "./subscriptions": {
      "types": "./types/subscriptions.d.ts",
      "import": "./dist/subscriptions/index.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./qm": {
      "types": "./types/qm.d.ts",
      "import": "./dist/qm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "bin",
    "src"
  ],
  "bin": {
    "boilerplate": "./bin/cli.js"
  },
  "scripts": {
    "babel:node": "./node_modules/.bin/babel-node --presets=@babel/env",
    "dev": "nodemon --exec npm run babel:node -- ./src/index.js",
    "dev:types": "node bin/watch-types.js",
    "generate:types": "node bin/generate-boilerplate-types.js",
    "generate:graphql": "graphql-codegen --config codegen.yml",
    "sync:entity": "node bin/sync-entity.js",
    "prebuild": "npm run generate:types",
    "build": "rm -rf dist && babel ./src -d dist --copy-files",
    "start": "npm run babel:node -- ./src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "graphql:codegen": "node scripts/generate-graphql-types.js",
    "graphql:watch": "graphql-codegen --config codegen.yml --watch",
    "prepare": "husky install || true",
    "lint": "echo \"Linting...\" && exit 0",
    "semantic-release": "semantic-release"
  },
  "author": "Artem Tantsura <dualitysol@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@graphql-tools/schema": "^10.0.3",
    "@graphql-tools/stitch": "^9.0.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.48.0",
    "@opentelemetry/instrumentation": "^0.48.0",
    "@opentelemetry/instrumentation-graphql": "^0.38.0",
    "@opentelemetry/instrumentation-http": "^0.48.0",
    "@opentelemetry/resources": "^1.21.0",
    "@opentelemetry/sdk-trace-base": "^1.21.0",
    "@opentelemetry/sdk-trace-node": "^1.21.0",
    "@opentelemetry/semantic-conventions": "^1.21.0",
    "apollo-server": "^3.13.0",
    "axios": "^1.6.8",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "graphql": "^15.8.0",
    "graphql-request": "^6.1.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.6.0",
    "graphql-yoga": "^5.1.1",
    "inquirer": "^9.2.15",
    "mongodb": "^6.4.0",
    "reflect-metadata": "^0.2.1",
    "ws": "^8.16.0"
  },
  "optionalDependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.10",
    "amqplib": "^0.10.0",
    "nats": "^2.15.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.30.0",
    "zeromq": "^6.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.24.0",
    "@babel/node": "^7.23.9",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.23.7",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-codegen/typescript-resolvers": "^4.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.4",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "babel-jest": "^29.7.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
