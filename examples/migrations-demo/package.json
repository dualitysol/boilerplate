{
  "name": "migrations-demo",
  "version": "1.0.0",
  "description": "Database migrations demo with MigrationManager",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "migrate:up": "node ../../src/migrations/cli.js up",
    "migrate:down": "node ../../src/migrations/cli.js down",
    "migrate:status": "node ../../src/migrations/cli.js status",
    "migrate:create": "node ../../src/migrations/cli.js create",
    "migrate:verify": "node ../../src/migrations/cli.js verify",
    "migrate:reset": "node ../../src/migrations/cli.js reset"
  },
  "dependencies": {
    "mongodb": "^5.0.0",
    "pg": "^8.11.0",
    "mysql2": "^3.6.0"
  }
}
