# Todo App Environment Configuration

# Server Configuration
PORT=4000
NODE_ENV=development

# Database (optional - using in-memory by default)
# Uncomment to use PostgreSQL
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=todoapp
# DB_USER=postgres
# DB_PASSWORD=password

# Uncomment to use MongoDB
# DB_TYPE=mongodb
# DB_URL=mongodb://localhost:27017/todoapp

# Authentication (for production)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
