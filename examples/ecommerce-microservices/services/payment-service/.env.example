# Payment Service Environment Variables

# Service Configuration
NODE_ENV=development
PORT=4004
HOST=0.0.0.0

# Database
DB_TYPE=memory
# DB_TYPE=mongodb
# DATABASE_URL=mongodb://localhost:27017/ecommerce_payments

# Cache
CACHE_ENABLED=false
# CACHE_TYPE=redis
# REDIS_URL=redis://localhost:6379

# Event Bus (NATS)
EVENT_BUS_TYPE=memory
# EVENT_BUS_TYPE=nats
# NATS_SERVERS=nats://localhost:4222

# Queue
QUEUE_TYPE=memory
# QUEUE_TYPE=bullmq
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Distributed Tracing
TRACING_ENABLED=true
TRACING_PROVIDER=native
# TRACING_PROVIDER=opentelemetry

# For Native Tracing
TRACE_EXPORTER=console
# TRACE_EXPORTER=file
# TRACE_EXPORTER=jaeger

# For OpenTelemetry
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACE_SAMPLE_RATE=1.0

# Metrics
METRICS_ENABLED=false
METRICS_PORT=9094

# GraphQL
GRAPHQL_TRACING=false
CORS_ORIGIN=*

# Payment Providers
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

PAYPAL_ENABLED=false
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MODE=sandbox

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
